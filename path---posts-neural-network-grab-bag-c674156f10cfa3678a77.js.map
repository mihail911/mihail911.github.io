module.exports = {"data":{"site":{"siteMetadata":{"title":"Mihail Eric","subtitle":"Engineer, researcher, educator.","copyright":"Copyright","author":{"name":"Mihail Eric","twitter":"mihail_eric"},"url":"https://mihaileric.com"}},"allMarkdownRemark":{"edges":[{"node":{"fields":{"slug":"/Every-B2B-Saas-Coding/","tagSlugs":["/tags/ai/","/tags/llm/","/tags/coding-agents/"]},"frontmatter":{"title":"Every B2B SaaS Will Be a Coding Agent Company","tags":["ai","llm","coding-agents"],"date":"2026-06-11"}}},{"node":{"fields":{"slug":"/Demystifying-Claude-Code/","tagSlugs":["/tags/python/","/tags/ai/","/tags/llm/","/tags/coding-agents/","/tags/tutorial/"]},"frontmatter":{"title":"Claude Code Demystified: Whirring, Skidaddling, Flibbertigibetting","tags":["python","ai","llm","coding-agents","tutorial"],"date":"2026-02-02"}}},{"node":{"fields":{"slug":"/The-Emperor-Has-No-Clothes/","tagSlugs":["/tags/python/","/tags/ai/","/tags/llm/","/tags/coding-agents/","/tags/tutorial/"]},"frontmatter":{"title":"The Emperor Has No Clothes: How to Code Claude Code in 200 Lines of Code","tags":["python","ai","llm","coding-agents","tutorial"],"date":"2026-01-07"}}},{"node":{"fields":{"slug":"/posts/i-built-an-ai-hitch/","tagSlugs":["/tags/comedy/","/tags/nlp/","/tags/a-i/"]},"frontmatter":{"title":"I Built an AI Hitch","tags":["Comedy","NLP","A.I."],"date":"2024-11-09T23:40:37.121"}}},{"node":{"fields":{"slug":"/posts/how-alexa-dropped-the-ball-conversational-ai/","tagSlugs":["/tags/business/","/tags/nlp/","/tags/a-i/"]},"frontmatter":{"title":"How Alexa Dropped the Ball on Being the Top Conversational System on the Planet","tags":["Business","NLP","A.I."],"date":"2024-06-13T23:40:37.121"}}},{"node":{"fields":{"slug":"/posts/softare-engineer-does-standup-comedy/","tagSlugs":["/tags/business/","/tags/public-speaking/","/tags/comedy/"]},"frontmatter":{"title":"A Software Engineer Does 100 Standup Comedy Open Mics","tags":["Business","Public Speaking","Comedy"],"date":"2024-02-02T23:40:37.121"}}}